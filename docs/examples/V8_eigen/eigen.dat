
program log on
model new
model title

model config dyn
;model config fe
model large-strain off
;model random 10000

program call 'geometry.dat'

;block zone generate edgelength 0.1

block face triangulate radial-8
block contact gen-sub

block prop dens 1500
;block zone model cmodel assign el
;block zone prop dens 1500 young 1e9 poiss 0.25
;block gridpoint apply vel 0 0 0 range group 'Supports'



block contact jmodel assign el
block contact prop stiffness-normal 100e9 stiffness-shear 50e9
block contact material-table default prop stiffness-normal 100e9 stiffness-shear 50e9

block fix range group 'Supports'

; calculate eigenvalues for first 6 modes
model cyc 1

block dynamic eigen modes 8

program log off

; plot mode 1
block dyn eigen setm 

model save "sqpmodes"