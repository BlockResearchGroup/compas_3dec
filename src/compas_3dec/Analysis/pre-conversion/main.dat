;15/08/2023 10:17:27
    model new
    model large-strain on
    program call 'support_geometry.dat'
    program call 'block_geometry.dat'

    block contact generate-subcontacts
    block property density 2200 range group 'Supports'
    block contact property stiffness-normal 100000000000 stiffness-shear 70000000000 friction 35
    block contact material-table default property stiffness-normal 100000000000 stiffness-shear 70000000000
    block fix range group 'Supports'

    block property density 1000 range group 'Alex'
    block contact generate-subcontacts
    block contact property stiffness-normal 100000000000 stiffness-shear 70000000000 friction 35
    block contact material-table default property stiffness-normal 100000000000 stiffness-shear 70000000000

    block mechanical damping global

    plot create
    plot clear
    plot active on
    plot background 'white'
    plot item create block
    
    
    model gravity 0 0 -9.806
    model solve ratio-local 1e-06
    
    fish define out
      ii=io.out(' centr - result - veloc')
      ib = block.head
      ic = block.contact.head
      loop while ib#0
            bid = block.id(ib)
            br=block.region(ib)
        ii=io.out('block '+string(bid))
        ii=io.out('region '+string(br))
        ii=io.out('centroid'+' '+'='+' '+string(block.pos.x(ib),default,default,18)+','+string(block.pos.y(ib),default,default,18)+','+string(block.pos.z(ib),default,default,18)+' '+string(br))
        ii=io.out('mass '+' '+string(block.mass(ib)))
        ii=io.out('volume '+' '+string(block.vol(ib)))
        vel=block.vel(ib)
        rx=block.force.unbal.x(ib)
        ry=block.force.unbal.y(ib)
        rz=block.force.unbal.z(ib)
        lx=block.force.app.x(ib)
        ly=block.force.app.y(ib)
        lz=block.force.app.z(ib)
        ; if there is gravity, the block weight should be added
        rz=block.force.unbal.z(ib)+block.mass(ib)*global.gravity.z
        ii=io.out('forces'+' '+'='+' '+string(rx)+','+string(ry)+','+string(rz)+' '+string(br))
        ii=io.out('moment'+' '+'='+' '+string(block.moment.x(ib))+','+string(block.moment.y(ib))+','+string(block.moment.z(ib))+' '+string(br))
        ii=io.out('loads'+' '+'='+' '+string(lx)+','+string(ly)+','+string(lz)+' '+string(br))
        ii=io.out('velocity'+' '+'='+' '+string(vel)+' '+string(br))
        vi = block.gp.list(ib)
        loop while vi#0
            ii = io.out('vertex'+' '+'='+' '+string(block.gp.pos(vi),default,default,18)+' '+string(block.region(block.gp.hostblock(vi))))
            vi = block.gp.next(vi)
       endloop
      ib = block.next(ib)
      endloop
    end

log on
log-file 'init_state.txt'
@out
log off


    